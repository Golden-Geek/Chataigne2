{
  "schema_version": 1,
  "baseline": "supported-toolchain",
  "captured_at": "2026-07-27",
  "rust": {
    "channel": "1.97.0",
    "cargo_version": "1.97.0",
    "profile": "minimal",
    "components": [
      "rustfmt",
      "clippy"
    ],
    "hosts": {
      "windows_x64": "x86_64-pc-windows-msvc",
      "windows_arm64": "aarch64-pc-windows-msvc",
      "macos_x64": "x86_64-apple-darwin",
      "macos_arm64": "aarch64-apple-darwin",
      "linux_x64": "x86_64-unknown-linux-gnu",
      "linux_arm64": "aarch64-unknown-linux-gnu",
      "linux_armv7": "armv7-unknown-linux-gnueabihf"
    }
  },
  "node": {
    "version": "26.5.0",
    "npm_version": "11.17.0"
  },
  "python": {
    "version": "3.14"
  },
  "audio": {
    "cpal": "0.18.1",
    "asio_sys": "0.3.0",
    "asio_sdk": {
      "repository": "https://github.com/audiosdk/asio.git",
      "revision": "496a0765b8bb9c26f764f22f9a9712a937177db2",
      "license_mode": "GPL-3.0-only",
      "required_paths": [
        "LICENSE.txt",
        "common/asio.h",
        "common/asiosys.h",
        "host/asiodrivers.cpp",
        "host/asiodrivers.h",
        "host/pc/asiolist.cpp"
      ]
    },
    "normal_feature": "desktop",
    "qualification_feature": "full-desktop",
    "windows": {
      "native_host": "wasapi",
      "optional_hosts": [
        "asio",
        "jack"
      ],
      "asio_sdk_environment": "CPAL_ASIO_DIR",
      "asio_sdk_cache": "local-application-data/Chataigne2/tool-cache/asio-sdk/<revision>",
      "required_build_tools": [
        "visual-cpp",
        "llvm-clang"
      ]
    },
    "macos": {
      "native_host": "coreaudio",
      "optional_hosts": [
        "jack"
      ]
    },
    "linux": {
      "native_host": "alsa",
      "optional_hosts": [
        "jack",
        "pipewire"
      ],
      "realtime_feature": "realtime-dbus",
      "required_build_tools": [
        "clang",
        "pkg-config"
      ]
    }
  },
  "qualification_tools": {
    "cargo_deny": "0.20.2",
    "cargo_machete": "0.9.2"
  },
  "consumers": {
    "rust_version": "tools/bootstrap/rust-version",
    "node_version": ".nvmrc"
  }
}
