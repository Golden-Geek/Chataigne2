{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "Default permissions for the main desktop window, including custom titlebar dragging.",
  "windows": ["main"],
  "remote": {
    "urls": [
      "http://localhost:*",
      "http://127.0.0.1:*",
      "http://[::1]:*"
    ]
  },
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging"
  ]
}
