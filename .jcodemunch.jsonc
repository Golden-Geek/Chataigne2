    "src-ui/build/",
    "src-ui/.output/",
    "src-ui/.vercel/",
    "src-ui/.netlify/",
    "src-ui/.wrangler/",
    "src-ui/artifacts/",
    "src-ui/vite.config.js.timestamp-*",
    "src-ui/vite.config.ts.timestamp-*",
    "gen/schemas/",
    "src-ui/src/lib/golden_ui/generated/",
    "**/generated/rust_protocol/",
    ".env",
    ".env.*",
    "src-ui/.env",
    "src-ui/.env.*",
    ".idea/",
    ".vscode/",
    ".DS_Store",
    "Thumbs.db",
    "icons/",
    "src-ui/static/",
    "**/*.png",
    "**/*.jpg",
    "**/*.jpeg",
    "**/*.gif",
    "**/*.webp",
    "**/*.ico",
    "**/*.icns",
    "**/*.pdf",
