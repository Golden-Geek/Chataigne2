{
  "extra_ignore_patterns": [
    "/target/",
    "**/target/",
    "/target-ci-validate/",
    "**/*.rs.bk",
    "**/*.pdb",
    "**/mutants.out*/",

    "src-ui/node_modules/",
    "src-ui/.svelte-kit/",
    "src-ui/build/",
    "src-ui/.output/",
    "src-ui/.vercel/",
    "src-ui/.netlify/",
    "src-ui/.wrangler/",
    "src-ui/artifacts/",
    "src-ui/vite.config.js.timestamp-*",
    "src-ui/vite.config.ts.timestamp-*",

    "gen/schemas/",
    "src-ui/src/lib/golden_ui/generated/",
    "**/generated/rust_protocol/",

    ".env",
    ".env.*",
    "src-ui/.env",
    "src-ui/.env.*",

    ".idea/",
    ".vscode/",
    ".DS_Store",
    "Thumbs.db",

    "icons/",
    "src-ui/static/",
    "**/*.png",
    "**/*.jpg",
    "**/*.jpeg",
    "**/*.gif",
    "**/*.webp",
    "**/*.ico",
    "**/*.icns",
    "**/*.pdf",
    "**/*.zip",
    "**/*.tar",
    "**/*.gz"
  ],

  "watch_extra_ignore": [
    "/target/",
    "**/target/",
    "/target-ci-validate/",
    "**/*.rs.bk",
    "**/*.pdb",
    "**/mutants.out*/",
    "src-ui/node_modules/",
