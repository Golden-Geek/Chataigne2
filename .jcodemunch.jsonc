{
  // All MCP clients share ~/.code-index. VS Code owns the watcher lifecycle.
  "extra_extensions": {
    ".svelte": "typescript",
    // Index Markdown docs for text search. jCodeMunch has no Markdown grammar,
    // so map to "yaml" (an empty-symbol spec): no bogus symbols are extracted,
    // but the raw file content is stored so search_text finds it.
    ".md": "yaml",
    ".markdown": "yaml"
  },

  "watch": false,
  "watch_debounce_ms": 1000,
  "freshness_mode": "strict",

  "extra_ignore_patterns": [
    "/target/",
    "**/target/",
    "/target-ci-validate/",
    "**/*.rs.bk",
    "**/*.pdb",
    "**/mutants.out*/",
    ".kilo/",
    ".venv/",
    "src-ui/src/lib/golden_alchemist_ui/",
    "src-ui/src/lib/golden_ui/",
    "submodules/golden_alchemist_core/",
    "submodules/golden_core/",

    "src-ui/node_modules/",
    "src-ui/.svelte-kit/",
    "src-ui/build/",
    "src-ui/.output/",
    "src-ui/.vercel/",
    "src-ui/.netlify/",
    "src-ui/.wrangler/",
    "src-ui/artifacts/",
    "src-ui/vite.config.js.timestamp-*",
    "src-ui/vite.config.ts.timestamp-*",

    "gen/schemas/",
    "src-ui/src/lib/golden_ui/generated/",
    "**/generated/rust_protocol/",

    ".env",
    ".env.*",
    "src-ui/.env",
    "src-ui/.env.*",

    ".idea/",
    ".vscode/",
    ".DS_Store",
    "Thumbs.db",

    "icons/",
    "src-ui/static/",
    "**/*.png",
    "**/*.jpg",
    "**/*.jpeg",
    "**/*.gif",
    "**/*.webp",
    "**/*.ico",
    "**/*.icns",
    "**/*.pdf",
    "**/*.zip",
    "**/*.tar",
    "**/*.gz"
  ],

  "watch_extra_ignore": [
    "/target/",
    "**/target/",
    "/target-ci-validate/",
    "**/*.rs.bk",
    "**/*.pdb",
    "**/mutants.out*/",
    ".kilo/",
    ".venv/",
    "src-ui/src/lib/golden_alchemist_ui/",
    "src-ui/src/lib/golden_ui/",
    "submodules/golden_alchemist_core/",
    "submodules/golden_core/",
    "src-ui/node_modules/",
    "src-ui/.svelte-kit/",
    "src-ui/build/",
    "src-ui/.output/",
    "src-ui/.vercel/",
    "src-ui/.netlify/",
    "src-ui/.wrangler/",
    "src-ui/artifacts/",
    "src-ui/vite.config.js.timestamp-*",
    "src-ui/vite.config.ts.timestamp-*",
    "gen/schemas/",
    "src-ui/src/lib/golden_ui/generated/",
    "**/generated/rust_protocol/",
    ".env",
    ".env.*",
    "src-ui/.env",
    "src-ui/.env.*",
    ".idea/",
    ".vscode/",
    ".DS_Store",
    "Thumbs.db",
    "icons/",
    "src-ui/static/",
    "**/*.png",
    "**/*.jpg",
    "**/*.jpeg",
    "**/*.gif",
    "**/*.webp",
    "**/*.ico",
    "**/*.icns",
    "**/*.pdf",
    "**/*.zip",
    "**/*.tar",
    "**/*.gz"
  ]
}
