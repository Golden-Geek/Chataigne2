{
	"name": "chataigne-ui",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"engines": {
		"node": "^20.19.0 || >=22.12.0"
	},
	"scripts": {
		"dev": "vite dev --host 0.0.0.0 --port 5173",
		"dev:lan": "vite dev --host 0.0.0.0",
		"dev:copilot": "vite dev --host 127.0.0.1 --port 4173 --strictPort",
		"build": "vite build",
		"preview": "vite preview",
		"codegen:golden-ui-protocol": "cargo run --manifest-path ../submodules/golden_core/Cargo.toml -p golden_codegen_support --bin golden_codegen -- ui-protocol src/lib/golden_ui/generated/rust_protocol",
		"prepare": "npm run codegen:golden-ui-protocol && svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"smoke:ui": "node ./scripts/ui-browser-tools.mjs smoke",
		"inspect:ui": "node ./scripts/ui-browser-tools.mjs inspect",
		"lint": "prettier --check .",
		"format": "prettier --write ."
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^3.0.9",
		"@sveltejs/kit": "^2.50.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"playwright-core": "^1.56.1",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.4.1",
		"svelte": "^5.49.2",
		"svelte-check": "^4.3.6",
		"typescript": "^5.9.3",
		"vite": "^7.3.1",
		"vite-plugin-devtools-json": "^1.0.0"
	},
	"dependencies": {
		"@codemirror/lang-css": "^6.3.1",
		"@codemirror/lang-javascript": "^6.2.4",
		"@codemirror/theme-one-dark": "^6.1.3",
		"codemirror": "^6.0.2",
		"dockview-core": "^5.0.0",
		"golden_ui": "file:./src/lib/golden_ui"
	}
}
