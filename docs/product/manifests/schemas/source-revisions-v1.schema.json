{
  "$id": "source-revisions-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "entries": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "branch": {
            "type": [
              "string",
              "null"
            ]
          },
          "gitlink": {
            "pattern": "^[0-9a-f]{40}$",
            "type": "string"
          },
          "parent": {
            "type": "string"
          },
          "path": {
            "minLength": 1,
            "type": "string"
          },
          "url": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "path",
          "gitlink",
          "parent",
          "url",
          "branch"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "generated_by": {
      "type": "object"
    },
    "manifest_kind": {
      "enum": [
        "source_revisions"
      ],
      "type": "string"
    },
    "schema_version": {
      "enum": [
        1
      ],
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "manifest_kind",
    "generated_by",
    "entries"
  ],
  "type": "object"
}
