{
  "$id": "product-inventory-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "category_counts": {
      "type": "object"
    },
    "entries": {
      "items": {
        "oneOf": [
          {
            "additionalProperties": false,
            "properties": {
              "certainty": {
                "enum": [
                  "registered",
                  "declared",
                  "file_discovered"
                ],
                "type": "string"
              },
              "discovery_methods": {
                "items": {
                  "minLength": 1,
                  "type": "string"
                },
                "minItems": 1,
                "type": "array",
                "uniqueItems": true
              },
              "facts": {
                "type": "object"
              },
              "id": {
                "minLength": 1,
                "type": "string"
              },
              "kind": {
                "enum": [
                  "panel",
                  "command",
                  "node_type",
                  "anode",
                  "formula",
                  "module",
                  "script_method",
                  "script_callback",
                  "script_template",
                  "script_snippet"
                ],
                "type": "string"
              },
              "name": {
                "minLength": 1,
                "type": "string"
              },
              "sources": {
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "line": {
                      "minimum": 1,
                      "type": "integer"
                    },
                    "path": {
                      "minLength": 1,
                      "type": "string"
                    }
                  },
                  "required": [
                    "path",
                    "line"
                  ],
                  "type": "object"
                },
                "minItems": 1,
                "type": "array"
              }
            },
            "required": [
              "id",
              "kind",
              "name",
              "certainty",
              "discovery_methods",
              "sources",
              "facts"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "bytes": {
                "minimum": 0,
                "type": "integer"
              },
              "id": {
                "minLength": 1,
                "type": "string"
              },
              "kind": {
                "enum": [
                  "fixture",
                  "asset"
                ],
                "type": "string"
              },
              "name": {
                "minLength": 1,
                "type": "string"
              },
              "path": {
                "minLength": 1,
                "type": "string"
              },
              "sha256": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              }
            },
            "required": [
              "id",
              "kind",
              "name",
              "path",
              "bytes",
              "sha256"
            ],
            "type": "object"
          }
        ]
      },
      "type": "array"
    },
    "fixture_requirements": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "enum": [
              "P50-L1",
              "P5-L127"
            ],
            "type": "string"
          },
          "matches": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "type": "array",
            "uniqueItems": true
          },
          "status": {
            "enum": [
              "present",
              "absent"
            ],
            "type": "string"
          }
        },
        "required": [
          "id",
          "status",
          "matches"
        ],
        "type": "object"
      },
      "type": "array",
      "uniqueItems": true
    },
    "generated_by": {
      "type": "object"
    },
    "manifest_kind": {
      "enum": [
        "product_surfaces",
        "product_files"
      ],
      "type": "string"
    },
    "schema_version": {
      "enum": [
        1
      ],
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "manifest_kind",
    "generated_by",
    "category_counts",
    "entries"
  ],
  "type": "object"
}
