#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [[ -z "${repo_root}" ]]; then
  echo "pre-commit: unable to resolve repository root." >&2
  exit 1
fi

cd "${repo_root}"

mapfile -t staged_paths < <(git diff --cached --name-only --diff-filter=ACMR -- '*.rs' 'Cargo.toml' 'rustfmt.toml')
if [[ "${#staged_paths[@]}" -eq 0 ]]; then
  exit 0
fi

mapfile -t unstaged_paths < <(git diff --name-only --diff-filter=ACMR -- '*.rs' 'Cargo.toml' 'rustfmt.toml')
mapfile -t untracked_paths < <(git ls-files --others --exclude-standard -- '*.rs')

if [[ "${#unstaged_paths[@]}" -gt 0 || "${#untracked_paths[@]}" -gt 0 ]]; then
  echo "pre-commit: cargo fmt requires Rust files to be fully staged first." >&2
  if [[ "${#unstaged_paths[@]}" -gt 0 ]]; then
    echo "Unstaged Rust-related paths:" >&2
    printf '  %s\n' "${unstaged_paths[@]}" >&2
  fi
  if [[ "${#untracked_paths[@]}" -gt 0 ]]; then
    echo "Untracked Rust files:" >&2
    printf '  %s\n' "${untracked_paths[@]}" >&2
  fi
  echo "Stage or stash those paths, then commit again." >&2
  exit 1
fi

if ! command -v cargo >/dev/null 2>&1; then
  echo "pre-commit: cargo was not found on PATH." >&2
  exit 1
fi

echo "pre-commit: running cargo fmt --all"
cargo fmt --all

git add -- "${staged_paths[@]}"