{
	"compilerOptions": {
		"allowArbitraryExtensions": true,
		"allowImportingTsExtensions": true,
		"esModuleInterop": true,
		"module": "ESNext",
		"moduleResolution": "bundler",
		"noEmit": true,
		"paths": {
			"golden_ui": ["../../../../../packages/golden-ui/index.ts"],
			"golden_ui/*": ["../../../../../packages/golden-ui/*"]
		},
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"strict": true,
		"target": "ES2023",
		"types": ["vite/client", "svelte"]
	},
	"include": ["fixture/**/*.ts", "fixture/**/*.svelte"]
}
