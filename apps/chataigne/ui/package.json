{
	"name": "chataigne-ui",
	"private": true,
	"version": "0.0.1",
	"license": "GPL-3.0-only",
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"engines": {
		"node": ">=26.5.0 <27",
		"npm": ">=11.17.0 <12"
	},
	"scripts": {
		"dev": "vite dev --host 0.0.0.0 --port 5173",
		"dev:lan": "vite dev --host 0.0.0.0",
		"dev:copilot": "vite dev --host 127.0.0.1 --port 4173 --strictPort",
		"build": "vite build",
		"preview": "vite preview",
		"test": "vitest run",
		"test:browser:trees": "node tests/browser/trees.mjs",
		"check:browser:trees": "svelte-check --tsconfig tests/browser/tsconfig.json",
		"check:browser:graphs": "svelte-check --tsconfig tests/browser/tsconfig.graphs.json",
		"codegen:golden-graph-ui": "cargo run --manifest-path ../../../Cargo.toml -p golden_codegen_support --bin golden_codegen -- graph-ui ../../../packages/golden-graph-ui/generated",
		"codegen:golden-ui-protocol": "cargo run --manifest-path ../../../Cargo.toml -p golden_codegen_support --bin golden_codegen -- ui-protocol ../../../packages/golden-ui/generated/rust_protocol",
		"codegen:state-machine-protocol": "cargo run --manifest-path ../../../Cargo.toml -p chataigne_state_machine --bin generate_state_machine_protocol -- src/lib/systems/state_machine/generated && prettier --write src/lib/systems/state_machine/generated",
		"codegen:sound-card-protocol": "cargo run --manifest-path ../../../Cargo.toml -p chataigne_sound_card_protocol --bin generate_sound_card_protocol -- src/lib/modules/audio/sound-card/generated",
		"codegen:alchemist-authoring": "cargo run --locked --manifest-path ../../../Cargo.toml -p chataigne_alchemist --bin generate_alchemist_authoring -- src/lib/systems/alchemist/generated/authoring && prettier --write src/lib/systems/alchemist/generated/authoring",
		"prepare": "npm run codegen:golden-graph-ui && npm run codegen:golden-ui-protocol && npm run codegen --workspace golden_audio_ui && npm run codegen:state-machine-protocol && npm run codegen:sound-card-protocol && npm run codegen:alchemist-authoring && svelte-kit sync",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"smoke:ui": "node ./scripts/ui-browser-tools.mjs smoke",
		"inspect:ui": "node ./scripts/ui-browser-tools.mjs inspect",
		"measure:graph-paint": "node ./scripts/graph-action-to-paint.mjs",
		"lint": "prettier --check .",
		"format": "prettier --write ."
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "4.0.0",
		"@sveltejs/kit": "3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/node": "26.6.5",
		"playwright-core": "^1.61.1",
		"prettier": "^3.9.5",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "5.57.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "8.1.6",
		"vitest": "4.1.12"
	},
	"dependencies": {
		"@codemirror/lang-css": "^6.3.1",
		"@codemirror/lang-javascript": "^6.2.5",
		"@codemirror/theme-one-dark": "^6.1.3",
		"codemirror": "^6.0.2",
		"dockview-core": "^7.0.2",
		"golden_audio_ui": "*",
		"golden_graph_ui": "*",
		"golden_ui": "*"
	}
}
