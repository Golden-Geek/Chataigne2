{
	"$schema": "../gen/schemas/desktop-schema.json",
	"identifier": "main-window",
	"description": "Permissions for MapGyver's main desktop window and the shared Golden host commands.",
	"windows": ["main"],
	"remote": {
		"urls": ["http://localhost:*", "http://127.0.0.1:*"]
	},
	"permissions": [
		"desktop-host",
		"mapgyver-shader-library:allow-browse-isf",
		"mapgyver-shader-library:allow-load-isf",
		"mapgyver-shader-library:allow-browse-fragcoord",
		"mapgyver-shader-library:allow-load-fragcoord",
		"mapgyver-shader-library:allow-shadertoy-key-configured",
		"mapgyver-shader-library:allow-set-shadertoy-key",
		"mapgyver-shader-library:allow-browse-shadertoy",
		"mapgyver-shader-library:allow-load-shadertoy",
		"core:default",
		"core:window:allow-start-dragging",
		"core:window:allow-minimize",
		"core:window:allow-toggle-maximize",
		"core:window:allow-close"
	]
}
