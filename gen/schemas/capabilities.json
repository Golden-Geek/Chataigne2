{
    "main-window": {
        "identifier": "main-window",
        "description": "Default permissions for the main desktop window, including custom titlebar dragging.",
        "remote": {
            "urls": [
                "http://localhost:*",
                "http://127.0.0.1:*",
                "http://[::1]:*"
            ]
        },
        "local": true,
        "windows": [
            "main"
        ],
        "permissions": [
            "core:default",
            "core:window:allow-start-dragging",
            "core:window:allow-minimize",
            "core:window:allow-toggle-maximize",
            "core:window:allow-close",
            "core:window:allow-destroy"
        ]
    }
}