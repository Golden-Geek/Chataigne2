{
  "name": "golden-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=24.18.0 <27",
    "npm": ">=11.12.0 <12"
  },
  "workspaces": [
    "apps/chataigne/ui",
    "packages/*"
  ],
  "scripts": {
    "check": "tsc --project tsconfig.json --noEmit && svelte-check --config ./svelte.config.js --tsconfig ./tsconfig.json",
    "test": "node --import tsx --test packages/golden-graph-ui/src/store.test.ts packages/golden-graph-ui/src/spatial-index.test.ts packages/golden-alchemist-ui/src/formula-store.test.ts packages/golden-statechart-ui/src/statechart-store.test.ts packages/golden-runtime-client/src/frame-stager.test.ts",
    "test:browser": "node --import tsx --test packages/golden-runtime-client/src/frame-stager.browser.test.ts packages/golden-graph-ui/src/graph-scale.browser.test.ts",
    "build": "npm run check"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "esbuild": "0.28.1",
    "playwright": "1.61.1",
    "svelte": "^5.49.2",
    "svelte-check": "^4.3.6",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
