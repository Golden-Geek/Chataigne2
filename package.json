{
  "name": "golden-workspace",
  "private": true,
  "version": "0.0.0",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=26.5.0 <27",
    "npm": ">=11.17.0 <12"
  },
  "workspaces": [
    "apps/chataigne/ui",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace chataigne-ui",
    "build": "npm run build --workspace chataigne-ui",
    "test": "npm run test --workspace golden_statechart_ui && npm run test --workspace chataigne-ui",
    "check": "npm run check --workspace chataigne-ui",
    "lint": "npm run lint --workspace chataigne-ui",
    "format": "npm run format --workspace chataigne-ui"
  }
}
