{
  "version": "2.0.0",
  "inputs": [
    {
      "id": "supercommitMessage",
      "type": "promptString",
      "description": "Commit message"
    }
  ],
  "tasks": [
    {
      "label": "Golden: full check",
      "type": "process",
      "command": "powershell",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}\\tools\\check.ps1"],
      "problemMatcher": []
    },
    {
      "label": "Golden: Rust tests",
      "type": "process",
      "command": "cargo",
      "args": ["test", "--workspace", "--all-features"],
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "Golden: browser scale gates",
      "type": "process",
      "command": "npm",
      "args": ["run", "test:browser"],
      "problemMatcher": []
    },
    {
      "label": "Golden: supercommit",
      "type": "process",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\tools\\supercommit.ps1",
        "${input:supercommitMessage}"
      ],
      "problemMatcher": []
    }
  ]
}
